# Django deployment settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false

# Query-analysis provider: auto, gemini, groq, openai, or anthropic.
# ``auto`` tries configured cloud providers and transparently falls back to
# conservative local query analysis if none are available.
AI_PROVIDER=auto

# Optional ordered list of models to try, as provider:model separated by commas.
# Leave empty to try Gemini's models, then GROQ_MODEL, OPENAI_MODEL, and Claude.
# Example: gemini:gemini-flash-lite-latest,groq:model-id
AI_MODEL_CHAIN=
# Total time allowed across all models before using local query analysis.
AI_TOTAL_TIMEOUT_SECONDS=45
# Time allowed for one model to answer.
AI_MODEL_TIMEOUT_SECONDS=15

# Each provider takes one key, and optionally backup keys separated by commas in
# <NAME>_API_KEYS. The next key is used when one runs out or is rejected. Backup
# keys must be created by a person and only help if each has its own usage limit.
#
# AI_DISABLED_PROVIDERS switches providers off while keeping their keys, for
# example while they have no credit: AI_DISABLED_PROVIDERS=openai,anthropic
AI_DISABLED_PROVIDERS=
#
# <NAME>_AVAILABLE_MODELS limits a provider's dropdown to these comma-separated
# models. `python manage.py check_models` tests models and prints this line.

# Gemini configuration; provider accounts may offer limited free tiers.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-lite-latest

# These providers are backups only when their default model is set here.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=

CEREBRAS_API_KEY=
CEREBRAS_API_KEYS=
CEREBRAS_MODEL=

MISTRAL_API_KEY=
MISTRAL_API_KEYS=
MISTRAL_MODEL=

COHERE_API_KEY=
COHERE_API_KEYS=
COHERE_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
DEEPSEEK_MODEL=

XAI_API_KEY=
XAI_API_KEYS=
XAI_MODEL=

OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=

# Claude's default model when this is empty is claude-opus-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
ANTHROPIC_MODEL=

# KMS legal database configuration (optional; mock used if unset)
KMS_API_BASE_URL=
KMS_API_TOKEN=
KMS_API_TIMEOUT_SECONDS=10
