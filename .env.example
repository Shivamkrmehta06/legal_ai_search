# Django deployment settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false

# Query-analysis provider: auto, gemini, or openrouter.
# ``auto`` tries configured cloud providers and transparently falls back to
# conservative local query analysis if none are available.
AI_PROVIDER=auto

# Gemini configuration; provider accounts may offer limited free tiers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter provides one cloud key for models from multiple vendors.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Legal Search

# KMS legal database configuration (optional; mock used if unset)
KMS_API_BASE_URL=
KMS_API_TOKEN=
KMS_API_TIMEOUT_SECONDS=10
